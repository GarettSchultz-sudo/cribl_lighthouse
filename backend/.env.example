# Copy to .env. None of these are required to run locally —
# the backend has graceful fallbacks for every integration.

# --- LLM ---
# If unset, classifier runs in MOCK mode (deterministic stub output).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# --- Slack ---
# If unset, Slack posts go to backend/outbox/slack/*.json instead of being sent.
SLACK_BOT_TOKEN=
SLACK_REVIEW_CHANNEL=#lighthouse-review
SLACK_SIGNING_SECRET=

# --- Jira ---
# If unset, Jira creates go to backend/outbox/jira/*.json instead of being sent.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_EPIC_ISSUE_TYPE=Epic
JIRA_STORY_ISSUE_TYPE=Story

# --- Polling ---
# Comma-separated subset of source IDs, or empty for all.
LIGHTHOUSE_SOURCES=
LIGHTHOUSE_POLL_INTERVAL_MINUTES=180
LIGHTHOUSE_DB_PATH=./data/lighthouse.db
LIGHTHOUSE_TODAY_OVERRIDE=
